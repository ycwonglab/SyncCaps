    "src/profiling/synccaps_readout_profile.py": {
      "origin": "synccaps_readout_profile.py",
      "status": "EXTENDED",
      "changed_lines": 46,
      "sha256_snapshot": "71364900214b63c082285939c3dfdd5709da48eac6d460628c04fd896c2612c7",
      "sha256_repo": "ba8fbf98b2622d1372cade43c8a739d4741afe784f2daa61bd5cccd9f29f8d18",
      "diff": [
        "+import subprocess",
        "+",
        "-from exp_base import DEVICE",
        "-from synccaps_followup_experiment import make_arms",
        "+from src.training.exp_base import DEVICE",
        "+from src.training.synccaps_followup_experiment import make_arms",
        "+def gpu_state():",
        "+    \"\"\"Snapshot contention-sensitive GPU state around a timing run.",
        "+",
        "+    Absolute latency on a laptop GPU is only meaningful if the device was",
        "+    otherwise idle and not clock-limited. Recording utilisation, SM clock and",
        "+    the clock ceiling INSIDE the output file means a reader can tell a clean",
        "+    measurement from one taken against a busy device, instead of having to",
        "+    trust that it was clean.",
        "+    \"\"\"",
        "+    q = ('utilization.gpu,memory.used,memory.total,temperature.gpu,'",
        "+         'clocks.sm,clocks.max.sm')",
        "+    try:",
        "+        out = subprocess.run(",
        "+            ['nvidia-smi', '--query-gpu=' + q, '--format=csv,noheader'],",
        "+            capture_output=True, text=True, timeout=10).stdout.strip()",
        "+        vals = [v.strip() for v in out.split(',')]",
        "+        return dict(zip(q.split(','), vals))",
        "+    except Exception as e:                                # pragma: no cover",
        "+        return {'error': '%s: %s' % (type(e).__name__, e)}",
        "+",
        "+",
        "+    state_before = gpu_state()",
        "-        ts, mem = timeit(model, x, args.warmup, args.iters)",
        "-        ts = sorted(ts)",
        "+        raw, mem = timeit(model, x, args.warmup, args.iters)",
        "+        ts = sorted(raw)",
        "+            # raw per-iteration wall times (ms), in measurement order, after",
        "+            # `warmup` untimed iterations. Persisted so the reported p50/p95",
        "+            # can be recomputed rather than taken on trust.",
        "+            timings_ms=raw,",
        "-                         torch=torch.__version__, bs=args.bs,",
        "+                         gpu_state_before=state_before,",
        "+                         gpu_state_after=gpu_state(),",
        "+                         torch=torch.__version__,",
        "+                         cuda=torch.version.cuda,",
        "+                         cudnn=torch.backends.cudnn.version(),",
        "+                         precision='fp32 (no autocast)',",
        "+                         synchronisation='torch.cuda.synchronize() before and '",
        "+                                         'after every timed iteration',",
        "+                         warmup=args.warmup, bs=args.bs,"
      ]
    },
