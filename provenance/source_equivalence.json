        "-    from exp_base import UCF11VideoDataset",
        "-    from synccaps_followup_experiment import DATASETS",
        "+    if dumps:",
        "+        z = np.load(dumps[0], allow_pickle=True)",
        "+        if 'group_id' in z.files:",
        "+            assert np.array_equal(z['test_idx'], test_idx), (",
